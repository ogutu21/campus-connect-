rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users can never grant themselves a different role or status.
    function safeProfile() {
      let d = request.resource.data;
      return d.get('role', 'student') == 'student'
        && d.get('accountStatus', 'active') == 'active'
        && d.get('name', '') is string
        && d.get('name', '').size() <= 100
        && d.get('studentId', '') is string
        && d.get('studentId', '').size() <= 40
        && d.get('programme', '') is string
        && d.get('programme', '').size() <= 100;
    }

    function validAssignment() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.get('course', '') is string && d.get('course', '').size() <= 40
        && d.priority in ['high', 'medium', 'low']
        && d.date is string && d.date.size() == 10
        && d.completed is bool;
    }

    function validCourse() {
      let d = request.resource.data;
      return d.code is string && d.code.size() > 0 && d.code.size() <= 20
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.credits is number && d.credits >= 0 && d.credits <= 20
        && d.get('grade', 0) is number && d.get('grade', 0) >= 0 && d.get('grade', 0) <= 100;
    }

    function validClass() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.day is number && d.day >= 0 && d.day <= 6
        && d.time is string && d.time.size() == 5
        && d.get('location', '') is string && d.get('location', '').size() <= 60;
    }

    function validGroup() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.get('course', '') is string && d.get('course', '').size() <= 40
        && d.get('joined', false) is bool
        && d.get('members', 1) is number;
    }

    // Announcements are published from the Firebase console (or Admin SDK) only.
    // Staff accounts are approved by adding a document at admins/{uid} in the Firebase Console.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Cafeteria menus: everyone signed in can read, approved staff publish (document ID = date).
    match /menus/{menuId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.date == menuId
        && request.resource.data.meals is map
        && request.resource.data.get('note', '') is string
        && request.resource.data.get('note', '').size() <= 200;
      allow delete: if isAdmin();
    }

    // Lost & found: shared with every signed-in student; only the author can edit or delete.
    match /lostfound/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && validLostFound()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validLostFound()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Reports are write-only for students; staff review them in the console.
    match /lfreports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('reason', '').size() <= 60;
      allow read, update, delete: if false;
    }

    // Resource library: shared between signed-in students. Posting needs a verified email.
    // Voting only ever adds or removes the caller's own uid in the voters list.
    function validResource() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'description', 'url', 'course', 'kind', 'posterName', 'uid', 'voters', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.get('description', '') is string && d.get('description', '').size() <= 500
        && d.get('url', '') is string && d.get('url', '').size() <= 300
        && d.get('url', '').matches('^(https?://.*)?$')
        && d.get('course', '') is string && d.get('course', '').size() <= 40
        && d.kind in ['link', 'notes', 'past-paper', 'video', 'tutorial', 'other']
        && d.get('posterName', '') is string && d.get('posterName', '').size() <= 40
        && d.uid is string;
    }

    function onlyOwnVoteChange() {
      let n = request.resource.data;
      let o = resource.data;
      let me = [request.auth.uid].toSet();
      return n.diff(o).affectedKeys().hasOnly(['voters'])
        && n.voters is list && n.voters.size() <= 1000
        // Exactly one entry is added or removed (the size check blocks duplicate padding).
        && ((n.voters.toSet().difference(o.voters.toSet()) == me
              && o.voters.toSet().difference(n.voters.toSet()).size() == 0
              && n.voters.size() == o.voters.size() + 1)
         || (o.voters.toSet().difference(n.voters.toSet()) == me
              && n.voters.toSet().difference(o.voters.toSet()).size() == 0
              && n.voters.size() == o.voters.size() - 1));
    }

    match /resources/{resourceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && validResource()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.voters == []
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && onlyOwnVoteChange();
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Resource reports are write-only for students; staff review them in the console.
    match /resreports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('reason', '').size() <= 60;
      allow read, update, delete: if false;
    }

    // Tutor directory: one listing per student (document ID = their uid). Contact details are
    // never public: students send a request that only the tutor (and the sender) can read.
    function validTutor() {
      let d = request.resource.data;
      return d.keys().hasOnly(['displayName', 'subjects', 'bio', 'mode', 'availability', 'rate', 'active', 'updatedAt'])
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40
        && d.subjects is string && d.subjects.size() > 0 && d.subjects.size() <= 300
        && d.bio is string && d.bio.size() > 0 && d.bio.size() <= 500
        && d.mode in ['online', 'in-person', 'both']
        && d.get('availability', '') is string && d.get('availability', '').size() <= 100
        && d.get('rate', '') is string && d.get('rate', '').size() <= 40
        && d.active is bool
        && d.updatedAt == request.time;
    }

    function validTutorRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['fromUid', 'fromName', 'subject', 'message', 'contact', 'status', 'createdAt'])
        && d.fromUid == request.auth.uid
        && d.fromName is string && d.fromName.size() > 0 && d.fromName.size() <= 40
        && d.get('subject', '') is string && d.get('subject', '').size() <= 40
        && d.message is string && d.message.size() > 0 && d.message.size() <= 300
        && d.contact is string && d.contact.size() > 0 && d.contact.size() <= 100
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /tutors/{tutorId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == tutorId
        && request.auth.token.email_verified == true
        && validTutor();
      allow delete: if request.auth != null && (request.auth.uid == tutorId || isAdmin());

      // The request ID is the sender's uid, so each student can have one open request per tutor.
      match /requests/{requestId} {
        allow create: if request.auth != null
          && request.auth.token.email_verified == true
          && requestId == request.auth.uid
          && tutorId != request.auth.uid
          && exists(/databases/$(database)/documents/tutors/$(tutorId))
          && validTutorRequest();
        allow read: if request.auth != null
          && (request.auth.uid == tutorId || request.auth.uid == resource.data.fromUid);
        // Only the tutor can change a request, and only its status.
        allow update: if request.auth != null
          && request.auth.uid == tutorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['new', 'seen', 'done'];
        allow delete: if request.auth != null
          && (request.auth.uid == tutorId || request.auth.uid == resource.data.fromUid);
      }
    }

    // Tutor reports are write-only for students; staff review them in the console.
    match /tutorreports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('reason', '').size() <= 60;
      allow read, update, delete: if false;
    }

    function validTodo() {
      let d = request.resource.data;
      return d.text is string && d.text.size() > 0 && d.text.size() <= 120
        && d.done is bool
        && d.get('createdAt', 0) is number;
    }

    function validNote() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.get('body', '') is string && d.get('body', '').size() <= 2000
        && d.get('course', '') is string && d.get('course', '').size() <= 40;
    }

    function validFocus() {
      let d = request.resource.data;
      return d.minutes is number && d.minutes >= 0 && d.minutes <= 1440
        && d.get('date', '') is string && d.get('date', '').size() <= 10;
    }

    function validPrefs() {
      let d = request.resource.data;
      return d.get('theme', 'light') in ['light', 'dark']
        && d.get('scene', 'aurora') in ['aurora', 'campus', 'doodles', 'plain']
        && d.get('motion', true) is bool
        && d.get('weeklyGoal', 150) is number
        && d.get('weeklyGoal', 150) >= 30 && d.get('weeklyGoal', 150) <= 1200
        && d.get('gpaScale', 'us') in ['us', 'uk']
        && d.get('readNotifications', []) is list
        && d.get('readNotifications', []).size() <= 200;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validLostFound() {
      let d = request.resource.data;
      return d.type in ['lost', 'found']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.get('description', '') is string && d.get('description', '').size() <= 500
        && d.get('category', '') is string && d.get('category', '').size() <= 40
        && d.get('place', '') is string && d.get('place', '').size() <= 80
        && isDateString(d.date)
        && d.get('contact', '') is string && d.get('contact', '').size() <= 100
        && d.get('posterName', '') is string && d.get('posterName', '').size() <= 40
        && d.get('status', 'open') in ['open', 'resolved']
        && d.get('photo', '') is string && d.get('photo', '').size() <= 200000
        && d.get('photo', '').matches('^(data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)?$')
        && d.uid is string;
    }

    function validJournal() {
      let d = request.resource.data;
      return isDateString(d.date)
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && d.get('prompt', '') is string && d.get('prompt', '').size() <= 200;
    }

    function isDateString(v) {
      return v is string && v.size() == 10;
    }

    function validAttendance() {
      let d = request.resource.data;
      return isDateString(d.date)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.status in ['present', 'late', 'absent']
        && d.get('classId', '') is string && d.get('classId', '').size() <= 40;
    }

    function validExam() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && isDateString(d.date)
        && d.get('course', '') is string && d.get('course', '').size() <= 40
        && d.get('time', '') is string && d.get('time', '').size() <= 5
        && d.get('venue', '') is string && d.get('venue', '').size() <= 80;
    }

    function validLoan() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.get('author', '') is string && d.get('author', '').size() <= 80
        && isDateString(d.due)
        && d.get('returned', false) is bool
        && d.get('renewed', 0) is number && d.get('renewed', 0) >= 0 && d.get('renewed', 0) <= 20;
    }

    function validExpense() {
      let d = request.resource.data;
      return d.amount is number && d.amount > 0 && d.amount <= 1000000000
        && d.type in ['expense', 'income']
        && d.category is string && d.category.size() <= 30
        && isDateString(d.date)
        && d.get('note', '') is string && d.get('note', '').size() <= 80;
    }

    function validBill() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.amount is number && d.amount >= 0 && d.amount <= 1000000000
        && isDateString(d.due)
        && d.get('paid', false) is bool;
    }

    function validBudget() {
      let d = request.resource.data;
      return d.monthly is number && d.monthly >= 0 && d.monthly <= 1000000000
        && d.get('currency', '$') is string && d.get('currency', '$').size() <= 4;
    }

    function validContact() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.get('phone', '') is string && d.get('phone', '').size() <= 30
        && d.get('note', '') is string && d.get('note', '').size() <= 80
        && d.get('kind', '') in ['', 'support'];
    }

    function validLink() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.url is string && d.url.size() <= 300 && d.url.matches('^https?://.*');
    }

    function validPlace() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.get('note', '') is string && d.get('note', '').size() <= 80;
    }

    function validShuttle() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.times is string && d.times.size() <= 200;
    }

    function validWellness() {
      let d = request.resource.data;
      return d.get('done', []) is list && d.get('done', []).size() <= 10
        && d.get('mood', 0) is number && d.get('mood', 0) >= 0 && d.get('mood', 0) <= 5
        && d.get('water', 0) is number && d.get('water', 0) >= 0 && d.get('water', 0) <= 30;
    }

    function validEvent() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && isDateString(d.date)
        && d.get('kind', '') is string && d.get('kind', '').size() <= 20
        && d.get('time', '') is string && d.get('time', '').size() <= 5
        && d.get('place', '') is string && d.get('place', '').size() <= 80
        && d.get('going', false) is bool;
    }

    match /users/{userId} {

      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && safeProfile();

      match /assignments/{assignmentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validAssignment();
        // Partial updates (e.g. toggling "completed") are validated on the merged result.
        allow update: if isOwner(userId) && validAssignment();
      }

      match /courses/{courseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCourse();
      }

      match /classes/{classId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validClass();
      }

      match /todos/{todoId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTodo();
      }

      match /notes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validNote();
      }

      match /focus/{dayId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validFocus();
      }

      match /settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPrefs();
      }

      match /groups/{groupId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validGroup();
      }

      match /attendance/{attendanceId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validAttendance();
      }

      match /exams/{examId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validExam();
      }

      match /loans/{loanId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validLoan();
      }

      match /expenses/{expenseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validExpense();
      }

      match /bills/{billId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validBill();
      }

      match /budget/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validBudget();
      }

      match /contacts/{contactId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContact();
      }

      match /links/{linkId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validLink();
      }

      match /places/{placeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPlace();
      }

      match /shuttle/{routeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validShuttle();
      }

      match /wellness/{dayId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validWellness();
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validEvent();
      }

      match /journal/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validJournal();
      }
    }
  }
}
